{
  "name": "dsh-model-connection-test",
  "version": "1.0.1",
  "description": "Connection tests for the models configured in Settings -> Models: one minimal chat round-trip per model, with failure codes and first-output/total latency. Credentials never leave the Host process.",
  "license": "MIT",
  "type": "module",
  "keywords": ["dsh", "deepseek-harness", "plugin", "models", "connectivity"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "README.zh.md", "LICENSE"],
  "engines": { "dsh": ">=0.2.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings-models"]
    }
  }
}
